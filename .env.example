# Site URL used for CSRF/origin checks on /api/order (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Owner WhatsApp number in international format without "+" (e.g. 14045551234), used to build wa.me notification links
OWNER_WHATSAPP_NUMBER=

# Owner email address that receives order notifications
OWNER_EMAIL=

# Verified "from" address for Resend (e.g. orders@yourdomain.com)
ORDER_FROM_EMAIL=

# Resend API key (https://resend.com)
RESEND_API_KEY=
